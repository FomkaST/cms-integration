    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE spare_parts\nSET is_active = FALSE\nWHERE is_active = TRUE\n  AND last_seen < (\n    '{{ $(\"Initialize\").first().json.syncStartedAt }}'::timestamptz\n    AT TIME ZONE 'UTC'\n  );",
        "options": {}
